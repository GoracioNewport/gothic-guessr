# Daily SQLite backup of Gothic II Guessr (deploy/scripts/backup-db.sh, installed as
# /usr/local/lib/gothic-guessr/backup-db.sh). Started by gothic-guessr-backup.timer; run by hand with
# `systemctl start gothic-guessr-backup`.
[Unit]
Description=Gothic II Guessr: SQLite backup
After=gothic-guessr.service

[Service]
Type=oneshot
User=g2
Group=g2
Environment=DB_PATH=/var/lib/gothic-guessr/db.sqlite
Environment=BACKUP_DIR=/var/backups/gothic-guessr
Environment=KEEP=14
ExecStart=/usr/local/lib/gothic-guessr/backup-db.sh
Nice=10
IOSchedulingClass=idle
UMask=0077

ProtectSystem=strict
ReadWritePaths=/var/lib/gothic-guessr /var/backups/gothic-guessr
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
MemoryMax=200M
