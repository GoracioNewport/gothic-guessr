{
  "name": "gothic2-guessr",
  "version": "1.0.0",
  "scripts": {
    "test": "vitest run",
    "dev": "concurrently -k -n client,server -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "build:server": "esbuild server/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --sourcemap --legal-comments=none --log-level=warning --outfile=dist-server/main.js",
    "preview": "vite preview",
    "dev:client": "vite --port 5173 --strictPort",
    "dev:server": "tsx watch --clear-screen=false server/main.ts",
    "start": "NODE_ENV=production node --enable-source-maps dist-server/main.js",
    "start:tsx": "NODE_ENV=production tsx server/main.ts",
    "setup": "tsx server/setup.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "assets": "bash tools/build_assets.sh"
  },
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@fontsource/alegreya": "^5.3.0",
    "@fontsource/alegreya-sc": "^5.3.0",
    "@fontsource/cormorant-sc": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/philosopher": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@photo-sphere-viewer/core": "^5.15.1",
    "@photo-sphere-viewer/cubemap-tiles-adapter": "^5.15.1",
    "@photo-sphere-viewer/virtual-tour-plugin": "^5.15.1",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.13",
    "leaflet": "^1.9.4",
    "ws": "^8.22.0"
  }
}
